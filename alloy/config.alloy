logging {
  level  = "info"
  format = "logfmt"
}

############################
# Docker logs
############################
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.local.receiver]

  labels = {
    job = "docker"
  }
}

############################
# App logs (with app tag from folder name)
############################
local.file_match "app_logs" {
  path_targets = [
    {
      __path__ = "/var/www/*/publish/storage/logs/*.log"
    }
  ]
}

loki.process "app_logs" {
  forward_to = [loki.write.local.receiver]

  stage.regex {
    expression = "/var/www/(?P<app>[^/]+)/publish/storage/logs/.*\\.log"
  }

  stage.labels {
    values = {
      app = "app"
      job = "applications"
    }
  }
}

loki.source.file "app_logs_source" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app_logs.receiver]
}

############################
# System logs
############################
local.file_match "system_logs" {
  path_targets = [
    {
      __path__ = "/var/log/*.log"
    }
  ]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
  forward_to = [loki.write.local.receiver]

  labels = {
    job = "system"
  }
}

############################
# Loki output
############################
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
